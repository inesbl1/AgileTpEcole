<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alpha School - Contact</title>
    <style>
        :root {
            --white: #ffffff;
            --black: #000000;
            --primecolor: #63b1af;
            --light: #EFEFEF;
            --lightgrey: #e9f6f5;
            --dark: #3A4852;
            --text: #343a40;
            --blue: #E8B12D;
            --lightblue: #98D6D3;
            --accent: #d45d40;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-md: 0 4px 20px rgba(0,0,0,0.12);
            --shadow-lg: 0 8px 40px rgba(0,0,0,0.15);
            --gradient-primary: linear-gradient(135deg, var(--primecolor) 0%, var(--lightblue) 100%);
            --gradient-accent: linear-gradient(135deg, var(--accent) 0%, #e67e63 100%);
            --gradient-card: linear-gradient(145deg, #faeeeeff 0%, var(--lightgrey) 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #faeeeeff;
            color: var(--text);
            line-height: 1.7;
            font-weight: 400;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header */
        header {
            background: transparent;
            color: var(--white);
            padding: 1.25rem 0;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            backdrop-filter: blur(0px);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        header.scrolled {
            background: var(--gradient-primary);
            box-shadow: var(--shadow-md);
            backdrop-filter: blur(10px);
            padding: 0.75rem 0;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .logo {
            font-size: 2rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--blue);
        }

        .logo-icon {
            font-size: 2.5rem;
            margin-right: 12px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 8px;
        }

        nav ul li a {
            color: var(--white);
            text-decoration: none;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        nav ul li a:hover, nav ul li a.active {
            background: var(--blue);
            color: var(--dark);
        }

        /* Hero Section avec image de fond */
        .contact-hero {
            position: relative;
            padding: 160px 0 80px 0;
            text-align: center;
            color: var(--white);
            margin-top: 0;
            min-height: 500px;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        /* Image de fond avec overlay gris transparent */
        .contact-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('https://images.unsplash.com/photo-1485322551133-3a4c27a9d925?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTh8fGJpYmxpb3RoZXF1ZXxlbnwwfHwwfHx8MA%3D%3D');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            z-index: -2;
        }

        /* Overlay gris transparent */
        .contact-hero::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(50, 50, 50, 0.6); /* Gris transparent */
            backdrop-filter: brightness(0.7) contrast(1.2);
            z-index: -1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            line-height: 1.2;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
            animation: fadeInUp 1s ease-out;
        }

        .hero-subtitle {
            font-size: 1.4rem;
            opacity: 0.95;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
            text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5);
            animation: fadeInUp 1s ease-out 0.3s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Effet parallax pour l'image */
        .contact-hero.parallax::before {
            background-attachment: fixed;
        }

        /* Main Content */
        main {
            flex: 1;
            padding: 4rem 0;
        }

        .contact-intro {
            text-align: center;
            margin-bottom: 4rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .contact-intro h2 {
            font-size: 2.5rem;
            color: var(--dark);
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .contact-intro p {
            font-size: 1.2rem;
            color: var(--text);
            opacity: 0.9;
        }

        /* School Location Section */
        .location-section {
            margin-bottom: 4rem;
        }

        .location-card {
            background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: all 0.3s ease;
    max-width: 60%; /* Prend toute la largeur disponible */
    width: 100%; /* S'assure qu'il prend toute la largeur */
    height: 70%;
    margin-bottom: 3rem; /* Même espacement que les autres sections */
    margin-left: 220px;
        }

        .location-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

        .location-header {
            background: var(--gradient-primary);
            padding: 2rem;
            color: white;
            text-align: center;
        }

        .location-title {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .location-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        .location-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
        }

        @media (max-width: 768px) {
            .location-content {
                grid-template-columns: 1fr;
            }
        }

        .map-container {
            height: 400px;
            position: relative;
            overflow: hidden;
        }

        .map-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .location-card:hover .map-image {
            transform: scale(1.05);
        }

        .map-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(99, 177, 175, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .location-details {
            padding: 2.5rem;
            background: var(--white);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .address-info {
            margin-bottom: 2rem;
        }

        .address-title {
            font-size: 1.4rem;
            color: var(--dark);
            margin-bottom: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .address-text {
            font-size: 1.1rem;
            line-height: 1.6;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .location-features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            background: white;
            border-radius: 10px;
            border-left: 4px solid var(--primecolor);
        }

        .feature-icon {
            width: 24px;
            height: 24px;
            object-fit: contain;
        }

        .feature-text {
            font-size: 0.9rem;
            color: var(--dark);
            font-weight: 600;
        }

        .location-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .location-btn {
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 2px solid transparent;
        }

        .location-btn.primary {
            background: var(--gradient-primary);
            color: white;
        }

        .location-btn.secondary {
            background: transparent;
            border-color: var(--primecolor);
            color: var(--primecolor);
        }

        .location-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .location-btn.primary:hover {
            background: transparent;
            border-color: var(--primecolor);
            color: var(--primecolor);
        }

        .location-btn.secondary:hover {
            background: var(--primecolor);
            color: white;
        }

        /* Contact Sections */
        .contact-sections {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 3rem;
            margin-bottom: 4rem;
        }

        .contact-card {
            background: var(--white);
            border-radius: 20px;
            padding: 3rem;
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
            border-top: 5px solid var(--primecolor);
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .contact-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-lg);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .card-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient-primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: white;
        }

        .card-title {
            font-size: 1.8rem;
            color: var(--dark);
            font-weight: 700;
            flex: 1;
        }

        .card-description {
            color: var(--text);
            margin-bottom: 2rem;
            line-height: 1.6;
            flex: 1;
        }

        .card-details {
            margin-top: auto;
        }

        .phone-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--dark);
            margin: 1rem 0;
        }

        .link-button {
            display: inline-block;
            background: var(--primecolor);
            color: white;
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            cursor: pointer;
        }

        .link-button:hover {
            background: transparent;
            border-color: var(--primecolor);
            color: var(--primecolor);
            transform: scale(1.05);
        }

        .support-links {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin: 1.5rem 0;
        }

        .support-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px;
            background: var(--lightgrey);
            border-radius: 12px;
            text-decoration: none;
            color: var(--dark);
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            width: 100%;
            text-align: left;
        }

        .support-link:hover {
            background: var(--lightblue);
            transform: translateX(5px);
        }

        .link-icon {
            font-size: 1.5rem;
        }

        /* CTA Section */
        .cta-section {
            background: var(--gradient-card);
            padding: 4rem;
            border-radius: 25px;
            text-align: center;
            margin: 4rem auto;
            max-width: 800px;
            box-shadow: var(--shadow-md);
        }

        .cta-title {
            font-size: 2.2rem;
            color: var(--dark);
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .cta-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .cta-button {
            padding: 16px 40px;
            border-radius: 30px;
            font-size: 1.1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .cta-button.primary {
            background: var(--gradient-primary);
            color: white;
        }

        .cta-button.secondary {
            background: transparent;
            border-color: var(--primecolor);
            color: var(--primecolor);
        }

        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        /* Contact Info */
        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 2px solid var(--lightgrey);
        }

        .info-item {
            text-align: center;
            padding: 2rem;
            background: var(--white);
            border-radius: 15px;
            box-shadow: var(--shadow-sm);
        }

        .info-icon {
            font-size: 2.5rem;
            color: var(--primecolor);
            margin-bottom: 1rem;
        }

        .info-title {
            font-size: 1.2rem;
            color: var(--dark);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .info-value {
            color: var(--text);
            font-size: 1.1rem;
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: var(--white);
            padding: 3rem 0 2rem 0;
            margin-top: auto;
        }

        .footer-content {
            text-align: center;
            margin-bottom: 2rem;
        }

        .footer-logo {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .footer-logo span {
            color: var(--blue);
        }

        .copyright {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }
            
            .contact-hero {
                padding: 140px 0 60px 0;
                min-height: 400px;
            }
            
            .hero-subtitle {
                font-size: 1.2rem;
            }
            
            .location-title {
                font-size: 1.8rem;
            }
            
            .contact-sections {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .contact-card {
                padding: 2rem;
            }
            
            .cta-section {
                padding: 2rem;
                margin: 2rem auto;
            }
            
            .cta-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .cta-button {
                width: 100%;
                max-width: 300px;
            }
            
            nav ul {
                gap: 4px;
            }
            
            nav ul li a {
                padding: 8px 16px;
                font-size: 0.9rem;
            }
            
            /* Désactiver le parallax sur mobile */
            .contact-hero.parallax::before {
                background-attachment: scroll;
            }
        }

        @media (max-width: 480px) {
            .hero-title {
                font-size: 2rem;
            }
            
            .contact-hero {
                min-height: 350px;
                padding: 120px 0 40px 0;
            }
            
            .card-title {
                font-size: 1.5rem;
            }
            
            .phone-number {
                font-size: 1.5rem;
            }
            
            .contact-info {
                grid-template-columns: 1fr;
            }
            
            .container {
                padding: 0 16px;
            }
        }

        /* Popup Styles */
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .popup-content {
            background: #fbf6f2ff;
            width: 90%;
            max-width: 900px;
            max-height: 85vh;
            border-radius: 5px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .popup-header {
            background: #3e4461ff;
            padding: 1.5rem 2rem;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
        }

        .popup-title {
            font-size: 1.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .close-popup {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            font-size: 1.8rem;
            cursor: pointer;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .close-popup:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: rotate(90deg);
        }

        .popup-body {
            padding: 2rem;
            overflow-y: auto;
            max-height: calc(85vh - 100px);
        }

        .search-container {
            margin-bottom: 2rem;
            
        }

        .search-input {
            width: 100%;
            padding: 14px 20px;
            border: 2px solid var(--accent);
            border-radius: 30px;
            font-size: 1.1rem;
            transition: all 0.3s ease;

        }

        .search-input:focus {
            outline: none;
            border-color: var(--primecolor);
            box-shadow: 0 0 0 3px rgba(99, 177, 175, 0.2);
            background: white;
        }

        .contact-category {
            margin-bottom: 2.5rem;
            background: var(--lightgrey);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(99, 177, 175, 0.2);
        }

        .category-title {
            font-size: 1.4rem;
            color: var(--dark);
            margin: 0;
            padding: 1.2rem 1.5rem;
            background: linear-gradient(135deg, var(--lightgrey) 0%, var(--lightblue) 100%);
            border-bottom: 2px solid var(--lightblue);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .category-icon {
            width: 36px;
            height: 36px;
            background: var(--gradient-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
        }

        .contact-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.2rem;
            padding: 1.5rem;
        }

        .contact-item {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            border-left: 5px solid var(--primecolor);
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            box-shadow: var(--shadow-sm);
            position: relative;
            overflow: hidden;
        }

        .contact-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            border-left-color: var(--accent);
        }

        .contact-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primecolor), var(--lightblue));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .contact-item:hover::before {
            opacity: 1;
        }

        .contact-name {
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 0.5rem;
            font-size: 1.2rem;
        }

        .contact-role {
            color: var(--primecolor);
            font-size: 1rem;
            margin-bottom: 0.8rem;
            font-weight: 700;
            background: rgba(99, 177, 175, 0.1);
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-block;
        }

        .contact-phone {
            color: var(--text);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
            margin-bottom: 0.8rem;
        }

        .phone-icon {
            color: var(--accent);
            font-size: 1.3rem;
        }

        .contact-email {
            color: var(--dark);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.9;
        }

        .email-icon {
            color: var(--blue);
        }

        .department-info {
            margin-top: 0.8rem;
            font-size: 0.9rem;
            color: var(--text);
            opacity: 0.8;
            padding-top: 0.8rem;
            border-top: 1px dashed var(--lightgrey);
        }

        .loading-spinner {
            text-align: center;
            padding: 3rem;
            color: var(--primecolor);
            font-size: 1.2rem;
        }

        .spinner {
            border: 4px solid var(--lightgrey);
            border-top: 4px solid var(--primecolor);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 1.5rem;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .no-contacts {
            text-align: center;
            padding: 3rem;
            color: var(--text);
            font-size: 1.1rem;
            opacity: 0.7;
        }

        .no-contacts .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--lightblue);
        }

        /* Responsive pour popup */
        @media (max-width: 768px) {
