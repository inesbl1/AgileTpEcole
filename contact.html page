        const searchInput = document.getElementById('searchContacts');

        function openAboutModal() {
            window.location.href = 'about.html';
        }

        // Fonction pour afficher les contacts
        function renderContacts(contacts = contactsData.contacts) {
            contactsContainer.innerHTML = '';
            
            if (contacts.length === 0) {
                contactsContainer.innerHTML = `
                    <div class="no-contacts">
                        <div class="icon">🔍</div>
                        <p>No contacts found matching your search criteria.</p>
                        <p>Try different keywords or check the directory.</p>
                    </div>
                `;
                return;
            }
            
            contacts.forEach(category => {
                const categoryHTML = `
                    <div class="contact-category">
                        <h3 class="category-title">
                            <span class="category-icon">${category.icon}</span>
                            ${category.category}
                        </h3>
                        <div class="contact-list">
                            ${category.members.map(member => `
                                <div class="contact-item">
                                    <div class="contact-name">${member.name}</div>
                                    <div class="contact-role">${member.role}</div>
                                    <div class="contact-phone">
                                        <span class="phone-icon">📞</span>
                                        ${member.phone}
                                    </div>
                                    ${member.email ? `
                                    <div class="contact-email">
                                        <span class="email-icon">✉️</span>
                                        ${member.email}
                                    </div>
                                    ` : ''}
                                    <div class="department-info">${member.department}</div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
                contactsContainer.innerHTML += categoryHTML;
            });
        }

        // Fonction pour filtrer les contacts
        function filterContacts(searchTerm) {
            searchTerm = searchTerm.toLowerCase().trim();
            
            if (!searchTerm) {
                renderContacts();
                return;
            }
            
            const filteredCategories = contactsData.contacts.map(category => {
                const filteredMembers = category.members.filter(member => {
                    return member.name.toLowerCase().includes(searchTerm) ||
                           member.role.toLowerCase().includes(searchTerm) ||
                           member.department.toLowerCase().includes(searchTerm) ||
                           member.phone.includes(searchTerm) ||
                           (member.email && member.email.toLowerCase().includes(searchTerm));
                });
                
                return {
                    ...category,
                    members: filteredMembers
                };
            }).filter(category => category.members.length > 0);
            
            renderContacts(filteredCategories);
        }

        // Événements
        viewNumbersBtn.addEventListener('click', () => {
            phonePopup.style.display = 'flex';
            renderContacts();
            searchInput.value = '';
            searchInput.focus();
        });

        closePopup.addEventListener('click', () => {
            phonePopup.style.display = 'none';
        });

        phonePopup.addEventListener('click', (e) => {
            if (e.target === phonePopup) {
                phonePopup.style.display = 'none';
            }
        });

        searchInput.addEventListener('input', (e) => {
            filterContacts(e.target.value);
        });

        // Fermer avec la touche Échap
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && phonePopup.style.display === 'flex') {
                phonePopup.style.display = 'none';
            }
        });

        // Gestion de la navbar au scroll
        window.addEventListener('scroll', function() {
            const header = document.querySelector('header');
            const scrollPosition = window.scrollY;
            
            if (scrollPosition > 100) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        // Initialisation
        document.addEventListener('DOMContentLoaded', function() {
            // Activer le lien de contact
            const currentPage = window.location.pathname;
            const navLinks = document.querySelectorAll('nav a');
            
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPage || 
                    (currentPage.includes('contact') && link.textContent.includes('Contact'))) {
                    link.classList.add('active');
                }
            });

            // Initialiser la navbar
            const header = document.querySelector('header');
            if (window.scrollY > 100) {
                header.classList.add('scrolled');
            }

            // Pré-charger les contacts
            renderContacts();
        });

        // Animation pour les contacts au chargement
        setTimeout(() => {
            const contactItems = document.querySelectorAll('.contact-item');
            contactItems.forEach((item, index) => {
                item.style.animationDelay = `${index * 0.05}s`;
                item.classList.add('animated');
            });
        }, 100);
